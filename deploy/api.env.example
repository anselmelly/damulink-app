# Copy to /srv/damulink/shared/api.env on the server (mode 600, owner deploy). Names only here: the real values never go in git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=damulink
DB_PASSWORD=
DB_NAME=damulink
# at least 32 random characters (the server refuses to start with less)
JWT_SECRET=
PBKDF2_ITERATIONS=310000
APP_URL=https://dl.anselmelly.com
ALLOWED_ORIGINS=https://dl.anselmelly.com
PORT=8790
# Never set OTP_FIXED_CODE here: the server refuses to start with it in production.

# Keys for the scheduled-work address (/api/cron/tick?key=...) and the SMS provider's reply address (/api/sms/inbound?key=...).
# The server already runs the scheduled work every minute by itself; CRON_KEY is only for calling it by URL.
CRON_KEY=
SMS_WEBHOOK_KEY=

# Testing on the server without an SMS provider: this six-digit code is accepted as the phone code for ANY phone, so anyone who
# knows it can verify a number. It only works with OTP_FIXED_ALLOW_SERVER=yes. OTP_FIXED_PHONES (optional, comma separated)
# limits it to those numbers. Remove all of these lines when an SMS provider is connected.
OTP_FIXED_CODE=
OTP_FIXED_ALLOW_SERVER=
OTP_FIXED_PHONES=
